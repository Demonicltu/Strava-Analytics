{
  "name": "strava-extractor",
  "version": "1.0.0",
  "description": "Extract detailed Strava activity data for AI analysis",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "crunch": "tsx src/pre_analyze.ts",
    "analyze": "tsx src/analyze.ts",
    "update": "tsx src/update_strava.ts",
    "fast": "tsx src/fast.ts",
    "bulk": "tsx src/bulk_fetch.ts",
    "recrunch": "tsx src/recrunch.ts",
    "compare": "tsx src/compare.ts",
    "garmin": "python garmin_sync.py --since 2025-11-11",
    "samsung": "python samsung_sync.py",
    "garmin:year": "python garmin_sync.py --since 2025-11-11",
    "digest": "tsx src/digest.ts",
    "records": "tsx src/records.ts",
    "dashboard": "tsx src/dashboard.ts",
    "build": "tsc",
    "build:bundle": "tsx build.ts",
    "dev": "tsx --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
